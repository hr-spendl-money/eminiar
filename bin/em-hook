#!/bin/sh
# Hook entry shim. Node and package-root resolution live in _resolve.sh.
# A hook must never block Claude: if nothing can run, print an empty JSON object.
. "$(dirname "$0")/_resolve.sh"
if [ ! -x "$NODE" ]; then
  echo "eminiar hook: no node binary found (run: npx eminiar install)" >&2
  echo '{}'
  exit 0
fi
if [ -z "$RUN" ]; then
  echo "eminiar hook: $DIR has no node_modules and no stable copy is pinned (run: npx eminiar install)" >&2
  echo '{}'
  exit 0
fi
exec "$NODE" "$RUN/dist/hook.js" "$@"
