#!/bin/sh
# CLI shim. Node and package-root resolution live in _resolve.sh.
. "$(dirname "$0")/_resolve.sh"
if [ ! -x "$NODE" ]; then
  echo "eminiar: node >= 22.12 is required" >&2
  exit 1
fi
if [ -z "$RUN" ]; then
  echo "eminiar: $DIR has no node_modules and no stable copy is pinned in $EM_HOME/root-path (run: npx eminiar install)" >&2
  exit 1
fi
exec "$NODE" "$RUN/dist/cli.js" "$@"
