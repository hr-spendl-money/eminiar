#!/bin/sh
# CLI shim. Prefers the pinned Node, falls back to whatever is on PATH.
DIR="$(cd "$(dirname "$0")/.." && pwd)"
NODE=""
if [ -f "$HOME/.eminiar/node-path" ]; then
  NODE="$(cat "$HOME/.eminiar/node-path" 2>/dev/null)"
fi
if [ ! -x "$NODE" ]; then
  NODE="$(command -v node 2>/dev/null)"
fi
if [ ! -x "$NODE" ]; then
  echo "eminiar: node >= 22.12 is required" >&2
  exit 1
fi
exec "$NODE" "$DIR/dist/cli.js" "$@"
